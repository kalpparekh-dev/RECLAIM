# =====================================================================
# RECLAIM — Intelligent Payment Recovery & Decisioning Platform
# Environment Configuration Template (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. GATEWAY SELECTION MODE
# ---------------------------------------------------------------------
# Options: "SIMULATOR" (default sandbox) or "RAZORPAY" (Test/Live API)
PAYMENT_GATEWAY_TYPE=SIMULATOR

# ---------------------------------------------------------------------
# 2. RAZORPAY TEST MODE CREDENTIALS
# ---------------------------------------------------------------------
# Configure your Razorpay Dashboard Test Key ID and Secret below.
# Never expose secrets in client-side code, git repos, or public API logs.
# Test Key ID format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ---------------------------------------------------------------------
# 3. RAZORPAY WEBHOOK SECURITY
# ---------------------------------------------------------------------
# Configured in Razorpay Dashboard -> Settings -> Webhooks
# Endpoint: https://<your-domain>/api/webhooks/razorpay
# Signature Header: X-Razorpay-Signature
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Enforce strict HMAC-SHA256 signature verification on webhooks
REQUIRE_WEBHOOK_SIGNATURE=true

# ---------------------------------------------------------------------
# 4. SAFETY LOCKS & PRODUCTION GUARDRAILS
# ---------------------------------------------------------------------
# Hard-lock simulation mode to prevent real financial action dispatch
SIMULATION_MODE=true
ALLOW_REAL_ACTIONS=false

# ---------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ---------------------------------------------------------------------
# Public Key ID for Razorpay Checkout Modal (Safe for client-side bundle)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
VITE_API_BASE_URL=
